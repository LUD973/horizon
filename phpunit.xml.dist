<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="wp-content/plugins/fcp-horizon-bridge/tests/bootstrap.php"
    colors="true"
    cacheResultFile=".phpunit.result.cache">
    <testsuites>
        <testsuite name="unit">
            <directory>wp-content/plugins/fcp-horizon-bridge/tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>wp-content/plugins/fcp-horizon-bridge/tests/Integration</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <!-- Couverture ciblée sur la LOGIQUE MÉTIER critique (~70 %), pas uniforme. -->
            <directory suffix=".php">wp-content/plugins/fcp-horizon-bridge/includes/Domain</directory>
        </include>
    </coverage>
</phpunit>
