# =============================================================================
# French Class Prestige — Horizon : variables d'environnement (MODÈLE)
# -----------------------------------------------------------------------------
# Copier ce fichier en `.env` et renseigner les valeurs réelles.
# NE JAMAIS committer le fichier `.env` (voir .gitignore).
# Aucun secret ne doit apparaître côté navigateur.
#
# Ce fichier liste UNIQUEMENT les variables réellement lues par
# `includes/Support/Config.php`. Toute variable retirée du code doit être
# retirée d'ici dans le même lot.
# =============================================================================

# --- Environnement ---
FCP_ENV=local                       # local | staging | production
FCP_DEBUG=true                      # lue par Config, aucun consommateur applicatif à ce jour

# --- Supabase ---
# Staging et production utilisent deux projets Supabase DISTINCTS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                  # lue par Config, aucun consommateur applicatif à ce jour
SUPABASE_SERVICE_ROLE_KEY=          # clé serveur — SECRÈTE, jamais exposée au navigateur

# --- Sécurité API ---
FCP_ALLOWED_ORIGINS=https://staging.example.tld   # CORS restrictif (liste séparée par des virgules)
FCP_RATE_LIMIT_PER_MIN=5            # requêtes/minute/IP sur le formulaire public

# --- WhatsApp ---
# Numéro professionnel OFFICIEL unique (affichage public + lien wa.me).
# Config centrale : ne jamais coder ce numéro en dur ailleurs.
FCP_WHATSAPP_NUMBER=+33656898611     # public : +33 6 56 89 86 11 — technique E.164 ci-contre
# Réservé au futur lot « WhatsApp API » (numéro dédié à l'API, distinct si un jour créé).
# BREVO_WHATSAPP_SENDER=

# --- E-mail transactionnel Brevo (Semaine 5) ---
BREVO_API_KEY=                       # SECRET — configuration serveur uniquement
FCP_MAIL_FROM=contact@example.tld    # expéditeur (domaine authentifié SPF/DKIM)
FCP_MAIL_FROM_NAME=French Class Prestige
FCP_MAIL_INTERNAL=ops@example.tld    # destinataire de l'alerte interne FCP

# --- Consentement (tarteaucitron.js, Semaine 6) ---
# Lien PUBLIC vers la politique de confidentialité (pas un secret). Doit être
# en HTTPS ; une valeur absente ou invalide désactive le CMP (aucune bannière,
# aucune erreur). Voir docs/CONSENT_TARTEAUCITRON.md.
TARTEAUCITRON_PRIVACY_URL=
# URL du script coeur (auto-hébergement possible). Doit être en HTTPS ; sinon
# neutralisée au profit du CDN officiel par défaut.
# TARTEAUCITRON_SCRIPT_URL=https://cdn.jsdelivr.net/npm/tarteaucitronjs@1/tarteaucitron.min.js

# --- Analytics (GoatCounter, Semaine 6) ---
# Point d'entrée de comptage (ex. https://<votre-code>.goatcounter.com/count).
# Doit être en HTTPS ; une valeur absente ou invalide neutralise l'analytics
# (aucun script injecté, aucune requête). Voir docs/ANALYTICS_GOATCOUNTER.md.
GOATCOUNTER_ENDPOINT=
# URL du script (auto-hébergement possible). Doit être en HTTPS ; sinon
# neutralisée au profit de la valeur par défaut ci-dessous.
# GOATCOUNTER_SCRIPT_URL=https://gc.zgo.at/count.js
