# =============================================================================
# French Class Prestige — Horizon : variables d'environnement (MODÈLE)
# -----------------------------------------------------------------------------
# Copier ce fichier en `.env` et renseigner les valeurs réelles.
# NE JAMAIS committer le fichier `.env` (voir .gitignore).
# Aucun secret ne doit apparaître côté navigateur.
# =============================================================================

# --- Environnement ---
FCP_ENV=local                       # local | staging | production
FCP_DEBUG=true                      # false en production

# --- Supabase (région Europe / Frankfurt) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                  # clé publique (lecture publique restreinte)
SUPABASE_SERVICE_ROLE_KEY=          # clé serveur — SECRÈTE, jamais exposée au navigateur

# --- Sécurité API ---
FCP_ALLOWED_ORIGINS=https://staging.example.tld   # CORS restrictif (liste séparée par des virgules)
FCP_RATE_LIMIT_PER_MIN=5            # requêtes/minute/IP sur le formulaire public

# --- WhatsApp ---
# Numéro professionnel OFFICIEL unique (affichage public + lien wa.me).
# Config centrale : ne jamais coder ce numéro en dur ailleurs.
FCP_WHATSAPP_NUMBER=+33656898611     # public : +33 6 56 89 86 11 — technique E.164 ci-contre
# Réservé au futur lot « WhatsApp API » (numéro dédié à l'API, distinct si un jour créé).
# BREVO_WHATSAPP_SENDER=

# --- E-mail transactionnel Brevo (Semaine 5) ---
BREVO_API_KEY=                       # SECRET — configuration serveur uniquement
FCP_MAIL_FROM=contact@example.tld    # expéditeur (domaine authentifié SPF/DKIM)
FCP_MAIL_FROM_NAME=French Class Prestige
FCP_MAIL_INTERNAL=ops@example.tld    # destinataire de l'alerte interne FCP

# --- Analytics / Consentement (activés en Semaine 5) ---
PLAUSIBLE_DOMAIN=
DIDOMI_NOTICE_ID=
