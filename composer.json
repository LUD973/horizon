{
  "name": "fcp/horizon",
  "description": "French Class Prestige — Horizon (mono-dépôt MVP) : thème enfant, plugin fcp-horizon-bridge, migrations Supabase.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "FCP\\Horizon\\": "wp-content/plugins/fcp-horizon-bridge/includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FCP\\Horizon\\Tests\\": "wp-content/plugins/fcp-horizon-bridge/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=phpcs.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
